<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>BankReconciliation.Core</RootNamespace>
    <AssemblyName>BankReconciliation.Core</AssemblyName>

    <!-- This project deliberately has NO WPF / Windows dependency. It is pure
         .NET and can be built, unit tested, and reused (CLI tool, service,
         another UI) on any platform. Only BankReconciliation.App is
         Windows-only. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ClosedXML: MIT licensed, no commercial-use restrictions (unlike
         EPPlus 5+/6+, which requires a paid license for commercial use).
         That made it the safer default for a tool this company will run
         internally. See README "Architecture Decisions". -->
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

</Project>
