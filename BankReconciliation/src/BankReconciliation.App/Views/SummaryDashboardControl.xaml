<UserControl x:Class="BankReconciliation.App.Views.SummaryDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <UniformGrid Columns="4" Rows="2">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding TotalBankTransactions, StringFormat=N0}" Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="Total Bank Transactions" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding TotalR365Transactions, StringFormat=N0}" Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="Total R365 Transactions" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                <StackPanel>
                    <TextBlock Text="{Binding MatchedBankTransactions, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="Matched Bank Transactions" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding MatchedAmount, StringFormat=C0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="Matched Amount" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding UnmatchedBankTransactions, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Unmatched Bank (No Match)" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding UnmatchedR365Transactions, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="Unmatched R365 (No Match)" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding OneToOneMatches, StringFormat=N0}" Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="One-to-One Matches" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding CombinationMatches, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource InfoBrush}"/>
                    <TextBlock Text="Combination Matches" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Columns="4" Margin="0,10,0,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding BankMatchPercentage, StringFormat={}{0:F1}%}" Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="Match Percentage" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding ManualReviewCount, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Manual Review" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding PossibleDuplicateBankCount, StringFormat=N0}" Style="{StaticResource KpiValueStyle}" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="Possible Duplicate (Bank)" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ProcessingTime.TotalSeconds, StringFormat={}{0:F1}s}" Style="{StaticResource KpiValueStyle}"/>
                    <TextBlock Text="Processing Time" Style="{StaticResource KpiLabelStyle}"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
