<UserControl x:Class="BankReconciliation.App.Views.StatusFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext flows through from MainWindow (MainViewModel) unchanged;
         this control just groups the filter buttons so they aren't repeated
         twice (Bank tab + R365 tab) in MainWindow.xaml. -->
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="Filter:" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Margin="0,0,10,0"/>
        <Button Content="All" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                Command="{Binding ApplyStatusFilterCommand}" CommandParameter="All"/>
        <Button Content="Matched" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                Command="{Binding ApplyStatusFilterCommand}" CommandParameter="Matched"/>
        <Button Content="Manual Review" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                Command="{Binding ApplyStatusFilterCommand}" CommandParameter="Manual Review"/>
        <Button Content="No Match" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                Command="{Binding ApplyStatusFilterCommand}" CommandParameter="No Match"/>
        <TextBlock Text="{Binding StatusFilter, StringFormat='  Showing: {0}'}" VerticalAlignment="Center"
                   Style="{StaticResource MutedTextStyle}" Margin="14,0,0,0"/>
        <TextBlock Text="Search:" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Margin="20,0,8,0"/>
        <TextBox Width="220" VerticalAlignment="Center" Padding="6,3"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search description, comment, amount, date, or Grouping value"/>
    </StackPanel>
</UserControl>
