<Window x:Class="BankReconciliation.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankReconciliation.App.Views"
        xmlns:conv="clr-namespace:BankReconciliation.App.Converters"
        mc:Ignorable="d"
        Title="Bank Reconciliation Tool" Height="820" Width="1320" MinHeight="620" MinWidth="1000"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseCommand}"/>
        <KeyBinding Key="F5" Command="{Binding StartCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <conv:MatchStatusToBrushConverter x:Key="StatusToBrush"/>
        <conv:MatchStatusToForegroundBrushConverter x:Key="StatusToForeground"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>

        <DataTemplate x:Key="StatusPillTemplate">
            <Border Style="{StaticResource StatusPillStyle}" Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{Binding Status, Converter={StaticResource StatusToForeground}}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header / toolbar -->
            <RowDefinition Height="Auto"/>   <!-- progress bar -->
            <RowDefinition Height="*"/>      <!-- content tabs -->
            <RowDefinition Height="Auto"/>   <!-- footer actions -->
        </Grid.RowDefinitions>

        <!-- ============ HEADER / TOOLBAR ============ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Bank Reconciliation Tool" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🌙 Dark Mode" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding ToggleThemeCommand}" Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <Button Content="☀ Light Mode" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding ToggleThemeCommand}" Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="⚙ Settings" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- File selection row -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#12FFFFFF" CornerRadius="6" Padding="10,8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFilePath, TargetNullValue='No file selected — click Browse, or drag &amp; drop a workbook anywhere in this window'}"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Button Grid.Column="1" Content="Browse Excel File…" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                            Command="{Binding BrowseCommand}"/>

                    <ComboBox x:Name="RecentFilesComboBox" Grid.Column="2" Width="34" Margin="8,0,0,0" ToolTip="Recent Files"
                              ItemsSource="{Binding RecentFiles}"
                              SelectionChanged="RecentFilesComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3" Content="▶ Start Reconciliation" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding StartCommand}"/>

                    <Button Grid.Column="4" Content="✕ Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ PROGRESS ============ -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20,10"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PassMessage}" Style="{StaticResource MutedTextStyle}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Elapsed: " Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Text="{Binding ElapsedDisplay}" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                        <TextBlock Text="Remaining: " Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Text="{Binding RemainingDisplay}" Style="{StaticResource MutedTextStyle}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Style="{StaticResource AppProgressBarStyle}" Margin="0,8,0,0"
                             Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- Status bar (always visible, even when idle) -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="20,8"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}"/>
        </Border>

        <!-- ============ CONTENT ============ -->
        <TabControl Grid.Row="2" Margin="20,16,20,16" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Summary Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,4,4">
                    <Grid>
                        <local:SummaryDashboardControl DataContext="{Binding Summary}" Visibility="{Binding HasResults, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="Run a reconciliation to see summary statistics here."
                                   Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,60,0,0"
                                   Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Bank Transactions">
                <DockPanel>
                    <local:StatusFilterBar DockPanel.Dock="Top" Margin="0,10,0,10"/>
                    <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding BankRowsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="60"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Grouping" Binding="{Binding GroupingKey}" Width="90"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="170" CellTemplate="{StaticResource StatusPillTemplate}"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="R365 Transactions">
                <DockPanel>
                    <local:StatusFilterBar DockPanel.Dock="Top" Margin="0,10,0,10"/>
                    <DataGrid Style="{StaticResource AppDataGridStyle}" ItemsSource="{Binding R365RowsView}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="60"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Grouping" Binding="{Binding GroupingKey}" Width="90"/>
                            <DataGridCheckBoxColumn Header="R365 Ref# Match" Binding="{Binding IsGroupedPosting}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="170" CellTemplate="{StaticResource StatusPillTemplate}"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ============ FOOTER ACTIONS ============ -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,10"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding OutputFilePath}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"
                           Margin="0,0,16,0" MaxWidth="480" TextTrimming="CharacterEllipsis"/>
                <Button Content="View Log" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding OpenLogCommand}"/>
                <Button Content="Export Needs-Review Report" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ExportReportCommand}"
                        ToolTip="Writes a CSV of every No Match / Manual Review / Possible Duplicate row from both sheets, for sharing without the full workbook"/>
                <Button Content="Show in Folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding OpenOutputFolderCommand}"/>
                <Button Content="Open Output File" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenOutputCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
