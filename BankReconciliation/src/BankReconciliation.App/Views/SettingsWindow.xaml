<Window x:Class="BankReconciliation.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Bank Reconciliation Tool" Height="700" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubHeadingTextStyle}">
            <Setter Property="Margin" Value="0,18,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldBoxStyle" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset to Defaults" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Command="{Binding ResetDefaultsCommand}"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Matching Rules" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10"/>

                <TextBlock Text="Maximum Date Difference (days R365 may be older than the bank date)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding MaxDateDifferenceDays, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Amount Tolerance ($)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding AmountToleranceDollars, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

                <TextBlock Text="Minimum Combination Confidence (%) — below this, matches go to Manual Review" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding MinCombinationConfidence, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Content="Ignore Already Reconciled Rows (skip rows that already have a comment)" Margin="0,16,0,0"
                          IsChecked="{Binding IgnoreAlreadyReconciledRows}"/>

                <CheckBox Content="Require the grouped-posting keyword for combination matching (unchecked = allow ANY R365 row to combine)" Margin="0,10,0,0"
                          IsChecked="{Binding RequireGroupKeywordForCombinations}"/>

                <TextBlock Text="Performance" Style="{StaticResource SectionHeaderStyle}"/>

                <TextBlock Text="Maximum Threads" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding MaxThreads, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                           Text="{Binding MaxThreadsCeiling, StringFormat='This machine has up to {0} logical processors available.'}"/>

                <TextBlock Text="Maximum Candidate Pool Size per combination search" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding MaxCombinationPoolSize, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Global Combination Search Time Budget (seconds)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4"/>
                <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding GlobalCombinationTimeBudgetSeconds, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Output" Style="{StaticResource SectionHeaderStyle}"/>
                <CheckBox Content="Auto-save output workbook when reconciliation completes" IsChecked="{Binding AutoSaveOutput}" Margin="0,0,0,8"/>
                <CheckBox Content="Write Match ID column (a sortable number shared by matched transactions)" IsChecked="{Binding WriteConfidenceColumn}" Margin="0,0,0,8"/>
                <CheckBox Content="Highlight the full transaction row (unchecked = comment cell only)" IsChecked="{Binding HighlightFullRow}" Margin="0,0,0,8"/>
                <CheckBox Content="Only highlight No Match rows in red (unchecked = also color Matched/Manual Review/Combination rows)" IsChecked="{Binding HighlightOnlyUnmatched}" Margin="0,0,0,8"/>
                <CheckBox Content="Hide blank spacer columns and autofit column widths to the header row" IsChecked="{Binding TidyColumnsOnOutput}"/>

                <TextBlock Text="Highlight Colors (hex)" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Matched" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MatchedColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Manual Review" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding ManualReviewColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="No Match" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding NoMatchColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Combination matches always use a rotating palette of blue/purple shades (one per group) so related transactions are visually traceable — see README for how to customize the palette."/>

                <TextBlock Text="Worksheet Names (Advanced)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Bank and R365 transactions live on two separate worksheets. Change these if your workbook names them differently — a close case-insensitive match is also accepted."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Bank Worksheet Name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding BankWorksheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="R365 Worksheet Name" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding R365WorksheetName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Column Mapping (Advanced)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Only change these if your workbook's layout differs from the standard template. Values are 1-based Excel column numbers (A=1, B=2, ... Z=26, AA=27)."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Bank: Date Column" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding BankDateColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Bank: Credit Amount Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding BankCreditColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Bank: Debit Amount Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding BankDebitColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Bank: Grouping Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding BankGroupingColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Bank: Comment Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding BankCommentColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="R365: Date Column" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding R365DateColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="R365: Grouping Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding R365GroupingColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="R365: Ref. # Column (older keyword rule, not Grouping)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4" TextWrapping="Wrap"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding R365ReferenceColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="R365: Amount Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding R365AmountColumn, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="R365: Comment Column" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource FieldBoxStyle}" Text="{Binding R365CommentColumn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Grouped Posting Keyword" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/>
                <TextBox Width="200" HorizontalAlignment="Left" Text="{Binding GroupKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Case-insensitive text the R365 Ref. # column is checked for (older, separate mechanism — not the Grouping column) to decide whether a row is a grouped (combination-eligible) posting."/>

                <TextBlock Text="Custom Matching Rules (Advanced)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Every bank row whose column contains the bank keyword is grouped with every R365 row whose column contains the R365 keyword — unconditionally, no amount or date check. Runs first, before every other pass, including Grouping-column matching. Ships with one rule (Bank column 8 / R365 Grouping column both contain &quot;Sysco&quot;); add more for other known patterns."/>

                <ItemsControl ItemsSource="{Binding SpecialComboRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bank col" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BaseTextStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding BankColumn, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="contains" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BaseTextStyle}"/>
                                    <TextBox Grid.Column="3" Text="{Binding BankKeyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="4" Text="R365 col" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BaseTextStyle}"/>
                                    <TextBox Grid.Column="5" Text="{Binding R365Column, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="6" Text="contains" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BaseTextStyle}"/>
                                    <TextBox Grid.Column="7" Text="{Binding R365Keyword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="9" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveCommand}" Padding="10,3"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ Add Rule" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                        Command="{Binding AddSpecialComboRuleCommand}" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
