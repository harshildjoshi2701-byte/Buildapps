<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme palette — same keys as Light.xaml, see remarks there. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15181E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1D2129"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232833"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#10141B"/>
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#F2F4F8"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEFF3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="AppBorderBrush" Color="#333944"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2F3A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#5C8DF2"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#75A0F5"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4574D6"/>

    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#2B303B"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#363C49"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4FCB9C"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#2A4A3D"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E4B93B"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#4A4126"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F0776A"/>
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#4A2A28"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#8FB2E8"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#2C3A52"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#262B35"/>
    <SolidColorBrush x:Key="GridAlternatingRowBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#272C37"/>

    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.35" BlurRadius="14" ShadowDepth="2" Direction="270"/>

</ResourceDictionary>
