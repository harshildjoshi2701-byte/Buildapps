<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF is Windows-only: the markup compiler that turns .xaml into BAML
         requires the Windows Desktop SDK and cannot build on Linux/macOS.
         This project can only be built and run on Windows — see README
         "Build Requirements". -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>BankReconciliation.App</RootNamespace>
    <AssemblyName>BankReconciliation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Self-contained/single-file/RID publish settings are intentionally NOT
         hardcoded here. build.bat passes them all as command-line -p: switches
         to `dotnet publish` instead, which is what actually produces the
         standalone exe. Hardcoding them in this PropertyGroup was tried
         first and caused the WPF XAML markup compiler's internal temporary
         build pass to fail to resolve ICollectionView; removing them from
         here (while build.bat still supplies them at publish time) avoids
         that problem. -->

    <Company>Xfinity Holdings</Company>
    <Product>Bank Reconciliation Tool</Product>
    <AssemblyTitle>Bank Reconciliation Tool</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BankReconciliation.Core\BankReconciliation.Core.csproj" />
  </ItemGroup>

</Project>
